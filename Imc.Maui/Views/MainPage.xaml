<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Imc.Maui.Views.MainPage"
             Title="Indice de masa corporal">

    <VerticalStackLayout
        Padding="24"
        Spacing="24">
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text="Proporcione el peso en kilogramos:"/>
                <Entry
                    BackgroundColor="WhiteSmoke"/>

                <Label
                    Text="Proporcione la estatura en metros:"/>
                <Entry
                    BackgroundColor="WhiteSmoke"/>

            </VerticalStackLayout>
        </Border>

        <HorizontalStackLayout
            Spacing="24"
            HorizontalOptions="Center">
            <Button
                Text="Calcular:"
                BackgroundColor="Green"
                Clicked="OnCalcular_ButtonClicked"/>

            <Button
                Text="Limpiar"
                Clicked="OnLimpiar_ButtonClicked"/>

        </HorizontalStackLayout>

        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text="El indice de masa corporal de la persona es:"/>
                <Label
                    Text="33453"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"/>

                <Label
                    Text="El estado nutricional de la persona es:"/>

                <Label
                        Text="Peso Normal"
                        HorizontalOptions="Center"
                        FontSize="Medium"
                        FontAttributes="Bold"/>


            </VerticalStackLayout>
        </Border>
       
    </VerticalStackLayout>

</ContentPage>