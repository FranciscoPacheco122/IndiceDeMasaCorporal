<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Imc.Views.MainPage"
             Title="MainPage">
    <VerticalStackLayout
        Padding="24"
        Spacing="24">
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label 
                 Text="Proporcione el peso en kilogramos:" />
                <Entry
                 BackgroundColor="WhiteSmoke"
                    x:Name="PesoEntry"/>
                <Label 
                 Text="Proporcione la estatura en metros:" />
                <Entry
                 BackgroundColor="WhiteSmoke"
                    x:Name="EstaturaEntry"/>
            </VerticalStackLayout>
        </Border>
        <HorizontalStackLayout
            Padding="24"
            HorizontalOptions="Center">
            <Button
                Text="Calcular"
                BackgroundColor="Green"
                Clicked="OnCalcularButton_Clicked"/>

            <Button
            Text="Limpiar"
            Clicked="OnLimpiarButton_Clicked"/>
        </HorizontalStackLayout>
        <Border>
            <VerticalStackLayout>
                <Label
                    Text="El indice de masa corporal de la persona es:"/>
                <Label
                    Text="23.4567"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"
                    x:Name="ImcLabel"/>
                <Label
                    Text="La situacion nutricional de la persona es:"/>
                <Label
                    Text="Peso Normal"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"
                    x:Name="EstadoNutricionalLabel"/>
            </VerticalStackLayout>
        </Border>


    </VerticalStackLayout>
</ContentPage>